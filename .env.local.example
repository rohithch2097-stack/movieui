# Frontend environment for local development
# Used to override defaults in vite.config.js

# Point to the Cloudflare Worker dev server (default: http://127.0.0.1:8787)
# You can override this if running on a different port:
# VITE_PROXY_TARGET=http://127.0.0.1:8787

# For production builds, set the deployed Worker domain:
# VITE_API_BASE_URL=https://your-worker-subdomain.workers.dev

